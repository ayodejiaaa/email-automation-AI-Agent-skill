{
  "master_enabled": false,
  "settings": {
    "from_name": "Dave from NoteVault",
    "from_email": "dave@notevault.com",
    "reply_to": "support@notevault.com",
    "physical_address": "1 Example Street, Lagos, Nigeria",
    "max_per_day": 1,
    "max_per_week": 4,
    "quiet_hours": { "start": "08:00", "end": "21:00" },
    "attribution_window_days": 7
  },
  "sequences": [
    {
      "key": "welcome",
      "name": "Welcome / activate",
      "enabled": false,
      "default_discount_pct": 0,
      "trigger": { "event": "registration" },
      "stop": ["login", "purchase", "unsubscribe"],
      "steps": [
        { "position": 1, "delay_minutes": 0, "copy": "welcome", "discount_pct": 0 },
        { "position": 2, "delay_minutes": 1440, "copy": "value", "discount_pct": 0 },
        { "position": 3, "delay_minutes": 4320, "copy": "social-proof", "discount_pct": 0 }
      ]
    },
    {
      "key": "no_login",
      "name": "Registered, never logged in",
      "enabled": false,
      "default_discount_pct": 0,
      "trigger": { "event": "registration", "condition": "no_login" },
      "stop": ["login", "unsubscribe"],
      "steps": [
        { "position": 1, "delay_minutes": 60, "copy": "youre-in" },
        { "position": 2, "delay_minutes": 1440, "copy": "friction" },
        { "position": 3, "delay_minutes": 4320, "copy": "last-nudge" }
      ]
    },
    {
      "key": "inactive_no_purchase",
      "name": "Logged in, no purchase/use",
      "enabled": false,
      "default_discount_pct": 0,
      "trigger": { "event": "login", "condition": "inactive_no_purchase" },
      "stop": ["purchase", "activation", "unsubscribe"],
      "steps": [
        { "position": 1, "delay_minutes": 60, "copy": "reengage" },
        { "position": 2, "delay_minutes": 1440, "copy": "value" },
        { "position": 3, "delay_minutes": 7200, "copy": "last-checkin" }
      ]
    },
    {
      "key": "abandoned_cart",
      "name": "Abandoned cart / checkout / product",
      "enabled": false,
      "default_discount_pct": 0,
      "trigger": { "event": "checkout_start", "condition": "no_purchase" },
      "stop": ["purchase", "unsubscribe"],
      "steps": [
        { "position": 1, "delay_minutes": 60, "copy": "cart-reminder", "discount_pct": 0 },
        { "position": 2, "delay_minutes": 1440, "copy": "social-proof", "discount_pct": 0 },
        { "position": 3, "delay_minutes": 3600, "copy": "urgency-incentive", "discount_pct": 10, "expiry_hours": 48 }
      ]
    },
    {
      "key": "post_purchase_review",
      "name": "Post-purchase review / experience",
      "enabled": false,
      "default_discount_pct": 0,
      "trigger": { "event": "purchase" },
      "stop": ["reviewed", "unsubscribe"],
      "steps": [
        { "position": 1, "delay_minutes": 1440, "copy": "how-is-it" },
        { "position": 2, "delay_minutes": 20160, "copy": "experience-upsell", "discount_pct": 0 }
      ]
    },
    {
      "key": "upsell",
      "name": "Upsell / cross-sell",
      "enabled": false,
      "default_discount_pct": 0,
      "trigger": { "event": "purchase", "condition": "other_products_exist" },
      "stop": ["purchase_promoted_item", "unsubscribe"],
      "steps": [
        { "position": 1, "delay_minutes": 4320, "copy": "because-you-bought", "discount_pct": 0 }
      ]
    },
    {
      "key": "win_back",
      "name": "Win-back / re-engagement",
      "enabled": false,
      "default_discount_pct": 0,
      "trigger": { "event": "inactivity", "days": 30 },
      "stop": ["activity", "unsubscribe"],
      "steps": [
        { "position": 1, "delay_minutes": 0, "copy": "neutral-checkin" },
        { "position": 2, "delay_minutes": 43200, "copy": "whats-new" },
        { "position": 3, "delay_minutes": 43200, "copy": "final-we-stop" }
      ]
    },
    {
      "key": "replenishment",
      "name": "Replenishment (consumables)",
      "enabled": false,
      "default_discount_pct": 0,
      "trigger": { "event": "purchase", "condition": "consumable" },
      "stop": ["repurchase", "unsubscribe"],
      "steps": [
        { "position": 1, "delay_minutes": 64800, "copy": "running-low", "discount_pct": 0 }
      ]
    }
  ]
}
